# Copy this file to .env locally and fill in your own values.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0

# Optional database override. Defaults to the local SQLite database.
# DATABASE_URL=postgresql://username:password@localhost:5432/portfolio

# Optional Gmail SMTP notification settings for the contact form.
MAIL_USERNAME=your-email@gmail.com
MAIL_APP_PASSWORD=your-new-google-app-password
MAIL_RECEIVER=your-email@gmail.com
